                  { "type": "Button", "text": "クイックセーブ", "flex": 1, "variant": "ghost", "action": "quicksave" },
                  { "type": "Button", "text": "クイックロード", "flex": 1, "variant": "ghost", "enabled": false, "action": "quickload" },
                  { "type": "Button", "text": "解説書", "flex": 1, "variant": "ghost", "action": "goto:manual" }
