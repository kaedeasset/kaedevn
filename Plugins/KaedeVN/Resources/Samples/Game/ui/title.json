          },
          { "type": "Panel", "variant": "spacer", "h": 8 },
          { "type": "Button", "text": "はじめる", "h": 64, "variant": "primary", "action": "newgame" },
          { "type": "Button", "text": "つづきから", "h": 56, "variant": "ghost", "action": "continue" },
          { "type": "Button", "text": "目次", "h": 56, "variant": "ghost", "action": "goto:toc" },
          { "type": "Button", "text": "設定", "h": 56, "variant": "ghost", "action": "goto:config" },
          { "type": "Button", "text": "終了", "h": 56, "variant": "ghost", "action": "quit", "hideIf": "touch" }
        ]
      }
    ]
